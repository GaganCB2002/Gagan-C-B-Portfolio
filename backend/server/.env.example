PORT=3001

# MongoDB connection string
# Option 1: Local MongoDB (install MongoDB Community Edition)
MONGODB_URI=mongodb://localhost:27017/gagan-portfolio

# Option 2: MongoDB Atlas (FREE cloud database)
# 1. Create free account at https://www.mongodb.com/atlas
# 2. Create cluster → Database Access → Add user → Network Access → Allow all (0.0.0.0/0)
# 3. Connect → Drivers → Copy connection string
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/gagan-portfolio?retryWrites=true&w=majority

# JWT Secret (change in production!)
JWT_SECRET=gagan-portfolio-secret-key-change-in-production

# Resend Email API (for 2FA OTP emails)
# Get free API key at https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM=onboarding@resend.dev

# CORS origin
CORS_ORIGIN=*

# Admin credentials (used for seeding)
ADMIN_EMAIL=gagancb2002@gmail.com
ADMIN_PASSWORD=Gagan@2002@2026